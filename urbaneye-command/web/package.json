{
  "name": "urbaneye-command-web",
  "private": true,
  "version": "1.0.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "npm run copy:ort && vite",
    "build": "npm run copy:ort && tsc && vite build",
    "preview": "vite preview",
    "copy:ort": "node -e \"const fs=require('fs'); fs.mkdirSync('public/ort', {recursive:true}); const srcDir='node_modules/onnxruntime-web/dist'; if(fs.existsSync(srcDir)){ fs.readdirSync(srcDir).filter(f=>f.endsWith('.wasm')).forEach(f=>fs.copyFileSync(srcDir+'/'+f, 'public/ort/'+f)); }\""
  },
  "dependencies": {
    "@types/leaflet": "^1.9.14",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "framer-motion": "^13.2.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.460.0",
    "onnxruntime-web": "^1.30.0",
    "postcss": "^8.4.49",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "socket.io-client": "^4.8.1",
    "tailwindcss": "^3.4.15",
    "typescript": "~5.6.2",
    "vite": "^5.4.11"
  }
}
